# PostgreSQL local — remplacez YOUR_PASSWORD par votre mot de passe
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/kinekids_db

# Générer une valeur aléatoire unique : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# Origines locales autorisées par défaut
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
